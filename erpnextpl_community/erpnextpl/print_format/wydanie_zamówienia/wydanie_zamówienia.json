 "html": "<div style=\"font-family: Inter, Arial, sans-serif; color: #0f172a; background: #f8fafc; padding: 24px 0;\">\n  <style>\n    .dn-wrap {\n      max-width: 880px;\n      margin: 0 auto;\n      background: #ffffff;\n      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);\n      border: 1px solid #e2e8f0;\n      overflow: hidden;\n    }\n    .dn-header {\n      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);\n      color: #fff;\n      padding: 28px 32px;\n    }\n    .dn-header-row {\n      display: flex;\n      justify-content: space-between;\n      gap: 24px;\n      align-items: flex-start;\n    }\n    .dn-kicker {\n      margin: 0 0 8px 0;\n      font-size: 12px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: rgba(255,255,255,0.68);\n    }\n    .dn-title {\n      margin: 0;\n      font-size: 32px;\n      line-height: 1.05;\n      font-weight: 700;\n      letter-spacing: -0.03em;\n    }\n    .dn-subtitle {\n      margin: 8px 0 0 0;\n      font-size: 14px;\n      color: rgba(255,255,255,0.82);\n    }\n    .dn-badge {\n      min-width: 170px;\n      text-align: right;\n      font-size: 12px;\n      line-height: 1.4;\n      color: rgba(255,255,255,0.9);\n    }\n    .dn-content {\n      padding: 28px 32px 34px 32px;\n      background: #fff;\n    }\n    .dn-meta {\n      display: flex;\n      gap: 16px;\n      margin-bottom: 22px;\n    }\n    .dn-meta-card {\n      flex: 1;\n      background: #f8fafc;\n      border: 1px solid #e2e8f0;\n      border-radius: 14px;\n      padding: 14px 16px;\n    }\n    .dn-label {\n      display: block;\n      margin: 0 0 6px 0;\n      font-size: 11px;\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      color: #64748b;\n      font-weight: 700;\n    }\n    .dn-value {\n      margin: 0;\n      font-size: 14px;\n      color: #0f172a;\n      font-weight: 600;\n      word-break: break-word;\n    }\n    .dn-section-title {\n      margin: 0 0 12px 0;\n      font-size: 13px;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      color: #475569;\n      font-weight: 700;\n    }\n    .dn-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 8px;\n      border: 1px solid #e2e8f0;\n      border-radius: 14px;\n      overflow: hidden;\n    }\n    .dn-table thead th {\n      background: #0f172a;\n      color: #fff;\n      text-align: left;\n      font-size: 12px;\n      padding: 12px 12px;\n      font-weight: 700;\n    }\n    .dn-table tbody td {\n      padding: 12px 12px;\n      border-top: 1px solid #e2e8f0;\n      font-size: 13px;\n      vertical-align: top;\n    }\n    .dn-table tbody tr:nth-child(even) td {\n      background: #f8fafc;\n    }\n    .dn-center { text-align: center; }\n    .dn-right { text-align: right; }\n    .dn-summary {\n      display: flex;\n      justify-content: flex-end;\n      margin-top: 18px;\n    }\n    .dn-summary-box {\n      width: 320px;\n      background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);\n      border: 1px solid #cbd5e1;\n      border-radius: 16px;\n      padding: 18px 18px 14px 18px;\n    }\n    .dn-summary-title {\n      margin: 0 0 6px 0;\n      color: #334155;\n      font-size: 11px;\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      font-weight: 700;\n    }\n    .dn-summary-total {\n      margin: 0;\n      font-size: 28px;\n      line-height: 1;\n      font-weight: 800;\n      color: #0f172a;\n    }\n    .dn-footer {\n      display: flex;\n      justify-content: space-between;\n      gap: 24px;\n      margin-top: 34px;\n      align-items: end;\n    }\n    .dn-signature {\n      flex: 1;\n    }\n    .dn-signature-line {\n      margin-top: 38px;\n      border-top: 1.5px solid #0f172a;\n      width: 280px;\n      max-width: 100%;\n    }\n    .dn-muted {\n      color: #64748b;\n      font-size: 12px;\n    }\n    @media print {\n      body { background: #fff !important; }\n      .dn-wrap { box-shadow: none; }\n    }\n  </style>\n\n  <div class=\"dn-wrap\">\n    <div class=\"dn-header\">\n      <div class=\"dn-header-row\">\n        <div>\n          <p class=\"dn-kicker\">Wydanie Zamówienia</p>\n          <h1 class=\"dn-title\">{{ doc.name }}</h1>\n          <p class=\"dn-subtitle\">Dokument wydania dla klienta i magazynu</p>\n        </div>\n        <div class=\"dn-badge\">\n          {% set cust_image = frappe.db.get_value(\"Customer\", doc.customer, \"image\") %}\n          <div style=\"display:inline-block; padding: 10px 12px; border-radius: 12px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);\">\n            <div style=\"font-weight: 700; font-size: 12px; margin-bottom: 6px;\">Klient</div>\n            {% if cust_image %}\n            <img src=\"{{ cust_image }}\" alt=\"Logo Klienta\" style=\"max-height: 64px; max-width: 150px; display:block; object-fit: contain; background: #fff; border-radius: 8px; padding: 4px;\">\n            {% else %}\n            <div style=\"font-size: 12px; color: rgba(255,255,255,0.7);\">Brak logo</div>\n            {% endif %}\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"dn-content\">\n      <div class=\"dn-meta\">\n        <div class=\"dn-meta-card\">\n          <span class=\"dn-label\">Identyfikator podatkowy</span>\n          <p class=\"dn-value\">{{ doc.tax_id or '-' }}</p>\n        </div>\n        <div class=\"dn-meta-card\">\n          <span class=\"dn-label\">Data</span>\n          <p class=\"dn-value\">{{ doc.posting_date }}</p>\n        </div>\n        <div class=\"dn-meta-card\">\n          <span class=\"dn-label\">Nazwa klienta</span>\n          <p class=\"dn-value\">{{ doc.customer_name }}</p>\n        </div>\n      </div>\n\n      <p class=\"dn-section-title\">Pozycje</p>\n      <table class=\"dn-table\">\n        <thead>\n          <tr>\n            <th style=\"width: 10%;\">Nr</th>\n            <th style=\"width: 35%;\">Kod identyfikacyjny</th>\n            <th style=\"width: 35%;\">Numer Zamówienia Klienta</th>\n            <th style=\"width: 20%;\">Ilość</th>\n          </tr>\n        </thead>\n        <tbody>\n          {% for item in doc.items %}\n            {% set po_no = frappe.db.get_value(\"Sales Order\", item.against_sales_order, \"po_no\") %}\n          <tr>\n            <td class=\"dn-center\">{{ loop.index }}</td>\n            <td>{{ item.item_code }}</td>\n            <td>{{ po_no or '-' }}</td>\n            <td class=\"dn-right\">{{ item.qty }}</td>\n          </tr>\n          {% endfor %}\n        </tbody>\n      </table>\n\n      <div class=\"dn-summary\">\n        <div class=\"dn-summary-box\">\n          <p class=\"dn-summary-title\">Całkowita ilość</p>\n          <p class=\"dn-summary-total\">{{ doc.total_qty }}</p>\n        </div>\n      </div>\n\n      <div class=\"dn-footer\">\n        <div class=\"dn-signature\">\n          <div class=\"dn-muted\">Podpis</div>\n          <div class=\"dn-signature-line\"></div>\n        </div>\n        <div class=\"dn-muted\" style=\"text-align:right; max-width: 220px;\">\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
