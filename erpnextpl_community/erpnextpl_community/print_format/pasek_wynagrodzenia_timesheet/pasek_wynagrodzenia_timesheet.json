 "html": "<!DOCTYPE html>\n<html lang=\"pl\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n  @page { size: A4; margin: 10mm 12mm; }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  body {\n    font-family: 'DejaVu Sans', Arial, sans-serif;\n    font-size: 9pt;\n    color: #1a1a2e;\n    background: #fff;\n  }\n\n  /* ===== HEADER ===== */\n  .slip-header {\n    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);\n    color: #fff;\n    padding: 16px 20px 14px;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    border-radius: 4px 4px 0 0;\n  }\n\n  .slip-header .company-block .company-name {\n    font-size: 15pt;\n    font-weight: 700;\n    letter-spacing: 0.5px;\n    margin-bottom: 2px;\n  }\n\n  .slip-header .company-block .doc-label {\n    font-size: 8pt;\n    color: #a0c4ff;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n  }\n\n  .slip-header .meta-block {\n    text-align: right;\n    font-size: 8pt;\n    color: #cdd8e3;\n    line-height: 1.6;\n  }\n\n  .slip-header .meta-block .doc-number {\n    font-size: 10pt;\n    font-weight: 700;\n    color: #fff;\n    letter-spacing: 0.5px;\n  }\n\n  .period-bar {\n    background: #e63946;\n    color: #fff;\n    text-align: center;\n    padding: 5px 20px;\n    font-size: 8.5pt;\n    font-weight: 600;\n    letter-spacing: 0.8px;\n    text-transform: uppercase;\n  }\n\n  /* ===== EMPLOYEE CARD ===== */\n  .employee-section {\n    display: flex;\n    gap: 0;\n    border-left: 4px solid #e63946;\n    margin: 14px 0 10px;\n    background: #f8f9fd;\n    border-radius: 0 4px 4px 0;\n    overflow: hidden;\n  }\n\n  .employee-avatar {\n    background: linear-gradient(135deg, #0f3460, #e63946);\n    color: #fff;\n    width: 52px;\n    min-width: 52px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 20pt;\n    font-weight: 700;\n  }\n\n  .employee-info {\n    padding: 10px 14px;\n    flex: 1;\n  }\n\n  .employee-info .emp-name {\n    font-size: 13pt;\n    font-weight: 700;\n    color: #0f3460;\n    line-height: 1.2;\n  }\n\n  .employee-info .emp-id {\n    font-size: 7.5pt;\n    color: #888;\n    margin-bottom: 6px;\n  }\n\n  .emp-details-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 6px 12px;\n    margin-top: 4px;\n  }\n\n  .emp-detail-item .label {\n    font-size: 6.5pt;\n    color: #999;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .emp-detail-item .value {\n    font-size: 8.5pt;\n    font-weight: 600;\n    color: #1a1a2e;\n  }\n\n  /* ===== TIMESHEET TABLE ===== */\n  .section-title {\n    font-size: 7.5pt;\n    font-weight: 700;\n    color: #0f3460;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    border-bottom: 2px solid #0f3460;\n    padding-bottom: 3px;\n    margin: 12px 0 6px;\n  }\n\n  .timesheet-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 8.5pt;\n    margin-bottom: 10px;\n  }\n\n  .timesheet-table thead tr {\n    background: #0f3460;\n    color: #fff;\n  }\n\n  .timesheet-table thead th {\n    padding: 5px 8px;\n    text-align: left;\n    font-weight: 600;\n    font-size: 7.5pt;\n    letter-spacing: 0.3px;\n  }\n\n  .timesheet-table thead th:last-child {\n    text-align: right;\n  }\n\n  .timesheet-table tbody tr:nth-child(even) {\n    background: #f0f4fc;\n  }\n\n  .timesheet-table tbody tr:hover {\n    background: #e0e9f5;\n  }\n\n  .timesheet-table tbody td {\n    padding: 4px 8px;\n    border-bottom: 1px solid #e8ecf5;\n    font-size: 8pt;\n  }\n\n  .timesheet-table tbody td:last-child {\n    text-align: right;\n    font-weight: 600;\n  }\n\n  .timesheet-table tfoot td {\n    padding: 5px 8px;\n    font-weight: 700;\n    background: #dce8f7;\n    color: #0f3460;\n    font-size: 8.5pt;\n  }\n\n  .timesheet-table tfoot td:last-child {\n    text-align: right;\n  }\n\n  /* ===== HOURS STATS BAR ===== */\n  .hours-stats {\n    display: flex;\n    gap: 8px;\n    margin: 0 0 12px;\n  }\n\n  .hours-stat-box {\n    flex: 1;\n    background: #f0f4fc;\n    border-radius: 4px;\n    padding: 7px 10px;\n    border-top: 3px solid #0f3460;\n    text-align: center;\n  }\n\n  .hours-stat-box.accent {\n    border-top-color: #e63946;\n    background: #fff0f1;\n  }\n\n  .hours-stat-box .stat-label {\n    font-size: 6.5pt;\n    color: #888;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 2px;\n  }\n\n  .hours-stat-box .stat-value {\n    font-size: 12pt;\n    font-weight: 700;\n    color: #0f3460;\n  }\n\n  .hours-stat-box.accent .stat-value {\n    color: #e63946;\n  }\n\n  .hours-stat-box .stat-unit {\n    font-size: 6.5pt;\n    color: #999;\n  }\n\n  /* ===== EARNINGS / DEDUCTIONS ===== */\n  .comp-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n    margin-bottom: 10px;\n  }\n\n  .comp-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 8.5pt;\n  }\n\n  .comp-table thead tr {\n    background: #16213e;\n    color: #fff;\n  }\n\n  .comp-table.deductions thead tr {\n    background: #6b1a1a;\n  }\n\n  .comp-table thead th {\n    padding: 5px 8px;\n    text-align: left;\n    font-size: 7.5pt;\n    letter-spacing: 0.3px;\n  }\n\n  .comp-table thead th:last-child {\n    text-align: right;\n  }\n\n  .comp-table tbody td {\n    padding: 4px 8px;\n    border-bottom: 1px solid #eef1f8;\n    color: #1a1a2e;\n  }\n\n  .comp-table tbody td:last-child {\n    text-align: right;\n    font-weight: 600;\n    color: #0f3460;\n  }\n\n  .comp-table.deductions tbody td:last-child {\n    color: #c0392b;\n  }\n\n  .comp-table tbody tr:nth-child(even) {\n    background: #f8f9fd;\n  }\n\n  .comp-table tfoot td {\n    padding: 5px 8px;\n    font-weight: 700;\n    border-top: 2px solid #0f3460;\n    background: #eef4fb;\n    color: #0f3460;\n    font-size: 8.5pt;\n  }\n\n  .comp-table.deductions tfoot td {\n    border-top-color: #6b1a1a;\n    background: #fdf0ef;\n    color: #c0392b;\n  }\n\n  .comp-table tfoot td:last-child {\n    text-align: right;\n  }\n\n  /* ===== NET PAY BANNER ===== */\n  .net-pay-banner {\n    background: linear-gradient(135deg, #0f3460 0%, #1a6b3c 100%);\n    color: #fff;\n    border-radius: 4px;\n    padding: 12px 18px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin: 10px 0;\n  }\n\n  .net-pay-banner .label-col .main-label {\n    font-size: 8pt;\n    color: #a0d9c0;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-bottom: 2px;\n  }\n\n  .net-pay-banner .label-col .words {\n    font-size: 8pt;\n    color: #cde8dc;\n    font-style: italic;\n  }\n\n  .net-pay-banner .amount-col {\n    text-align: right;\n  }\n\n  .net-pay-banner .amount-col .net-amount {\n    font-size: 20pt;\n    font-weight: 700;\n    letter-spacing: -0.5px;\n    line-height: 1;\n  }\n\n  .net-pay-banner .amount-col .currency-label {\n    font-size: 7.5pt;\n    color: #a0d9c0;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n\n  /* ===== SUMMARY ROW ===== */\n  .summary-row {\n    display: flex;\n    gap: 6px;\n    margin: 8px 0;\n  }\n\n  .summary-box {\n    flex: 1;\n    padding: 6px 10px;\n    border-radius: 3px;\n    text-align: center;\n    background: #f0f4fc;\n    border-bottom: 2px solid #0f3460;\n  }\n\n  .summary-box.earnings-box {\n    border-bottom-color: #27ae60;\n    background: #f0faf5;\n  }\n\n  .summary-box.deductions-box {\n    border-bottom-color: #c0392b;\n    background: #fff5f5;\n  }\n\n  .summary-box .s-label {\n    font-size: 6.5pt;\n    color: #888;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .summary-box .s-value {\n    font-size: 10pt;\n    font-weight: 700;\n    color: #0f3460;\n  }\n\n  .summary-box.earnings-box .s-value { color: #27ae60; }\n  .summary-box.deductions-box .s-value { color: #c0392b; }\n\n  /* ===== FOOTER ===== */\n  .slip-footer {\n    margin-top: 14px;\n    border-top: 1px solid #dde3ee;\n    padding-top: 8px;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n  }\n\n  .slip-footer .footer-left {\n    font-size: 7pt;\n    color: #aaa;\n    line-height: 1.5;\n  }\n\n  .signature-block {\n    text-align: center;\n    min-width: 140px;\n  }\n\n  .signature-block .sig-line {\n    border-top: 1px solid #1a1a2e;\n    margin-top: 20px;\n    padding-top: 4px;\n    font-size: 7pt;\n    color: #666;\n  }\n\n  .confidential-badge {\n    background: #fff3cd;\n    border: 1px solid #ffc107;\n    color: #856404;\n    font-size: 6.5pt;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    padding: 2px 8px;\n    border-radius: 2px;\n    display: inline-block;\n    margin-bottom: 4px;\n  }\n\n  /* ===== STATUS BADGE ===== */\n  .status-badge {\n    display: inline-block;\n    padding: 2px 8px;\n    border-radius: 10px;\n    font-size: 7pt;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .status-submitted { background: #d4edda; color: #155724; }\n  .status-draft { background: #fff3cd; color: #856404; }\n  .status-cancelled { background: #f8d7da; color: #721c24; }\n\n  @media print {\n    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n  }\n</style>\n</head>\n<body>\n\n{%- set company = doc.company -%}\n{%- set emp_initials = (doc.employee_name or '?')[:1].upper() -%}\n{%- set status_class = 'status-submitted' if doc.docstatus == 1 else ('status-cancelled' if doc.docstatus == 2 else 'status-draft') -%}\n{%- set status_label = 'Zatwierdzony' if doc.docstatus == 1 else ('Anulowany' if doc.docstatus == 2 else 'Wersja robocza') -%}\n\n<!-- HEADER -->\n<div class=\"slip-header\">\n  <div class=\"company-block\">\n    <div class=\"company-name\">{{ company }}</div>\n    <div class=\"doc-label\">Pasek Wynagrodzenia &mdash; Timesheet</div>\n  </div>\n  <div class=\"meta-block\">\n    <div class=\"doc-number\">{{ doc.name }}</div>\n    <div>Data wystawienia: {{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</div>\n    <div style=\"margin-top:4px;\">\n      <span class=\"status-badge {{ status_class }}\">{{ status_label }}</span>\n    </div>\n  </div>\n</div>\n\n<!-- PERIOD BAR -->\n<div class=\"period-bar\">\n  Okres rozliczeniowy:&nbsp;\n  {{ frappe.format(doc.start_date, {'fieldtype': 'Date'}) }}\n  &nbsp;&mdash;&nbsp;\n  {{ frappe.format(doc.end_date, {'fieldtype': 'Date'}) }}\n</div>\n\n<!-- EMPLOYEE CARD -->\n<div class=\"employee-section\">\n  <div class=\"employee-avatar\">{{ emp_initials }}</div>\n  <div class=\"employee-info\">\n    <div class=\"emp-name\">{{ doc.employee_name }}</div>\n    <div class=\"emp-id\">ID: {{ doc.employee }}</div>\n    <div class=\"emp-details-grid\">\n      <div class=\"emp-detail-item\">\n        <div class=\"label\">Dział</div>\n        <div class=\"value\">{{ doc.department or '&mdash;' }}</div>\n      </div>\n      <div class=\"emp-detail-item\">\n        <div class=\"label\">Stanowisko</div>\n        <div class=\"value\">{{ doc.designation or '&mdash;' }}</div>\n      </div>\n      <div class=\"emp-detail-item\">\n        <div class=\"label\">Oddział</div>\n        <div class=\"value\">{{ doc.branch or '&mdash;' }}</div>\n      </div>\n      <div class=\"emp-detail-item\">\n        <div class=\"label\">Tryb płatności</div>\n        <div class=\"value\">{{ doc.mode_of_payment or '&mdash;' }}</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- HOURS STATS -->\n<div class=\"hours-stats\">\n  <div class=\"hours-stat-box\">\n    <div class=\"stat-label\">Łączne godziny</div>\n    <div class=\"stat-value\">{{ doc.total_working_hours or 0 }}</div>\n    <div class=\"stat-unit\">godz.</div>\n  </div>\n  <div class=\"hours-stat-box\">\n    <div class=\"stat-label\">Stawka godzinowa</div>\n    <div class=\"stat-value\">{{ frappe.format(doc.hour_rate, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n    <div class=\"stat-unit\">/ godz.</div>\n  </div>\n  <div class=\"hours-stat-box\">\n    <div class=\"stat-label\">Dni robocze</div>\n    <div class=\"stat-value\">{{ doc.total_working_days or 0 }}</div>\n    <div class=\"stat-unit\">dni</div>\n  </div>\n  <div class=\"hours-stat-box\">\n    <div class=\"stat-label\">Dni płatności</div>\n    <div class=\"stat-value\">{{ doc.payment_days or 0 }}</div>\n    <div class=\"stat-unit\">dni</div>\n  </div>\n  <div class=\"hours-stat-box accent\">\n    <div class=\"stat-label\">Nieobecności (LWP)</div>\n    <div class=\"stat-value\">{{ doc.leave_without_pay or 0 }}</div>\n    <div class=\"stat-unit\">dni</div>\n  </div>\n</div>\n\n<!-- TIMESHEET TABLE -->\n{% if doc.timesheets %}\n<div class=\"section-title\">Rejestr czasu pracy (Timesheets)</div>\n<table class=\"timesheet-table\">\n  <thead>\n    <tr>\n      <th style=\"width:50%\">Nr Timesheets</th>\n      <th style=\"width:20%; text-align:right\">Przepracowane godziny</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for row in doc.timesheets %}\n    <tr>\n      <td>{{ row.time_sheet }}</td>\n      <td>{{ row.working_hours }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n  <tfoot>\n    <tr>\n      <td><strong>Suma</strong></td>\n      <td><strong>{{ doc.total_working_hours or 0 }} godz.</strong></td>\n    </tr>\n  </tfoot>\n</table>\n{% endif %}\n\n<!-- EARNINGS & DEDUCTIONS -->\n<div class=\"comp-grid\">\n  <!-- EARNINGS -->\n  <div>\n    <div class=\"section-title\" style=\"color:#1a6b3c; border-bottom-color:#1a6b3c;\">Przychody</div>\n    <table class=\"comp-table\">\n      <thead>\n        <tr>\n          <th style=\"width:65%\">Składnik</th>\n          <th>Kwota</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for row in doc.earnings %}\n        <tr>\n          <td>{{ row.salary_component }}</td>\n          <td>{{ frappe.format(row.amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n        {% endfor %}\n      </tbody>\n      <tfoot>\n        <tr>\n          <td>Wynagrodzenie brutto</td>\n          <td style=\"color:#1a6b3c\">{{ frappe.format(doc.gross_pay, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n      </tfoot>\n    </table>\n  </div>\n\n  <!-- DEDUCTIONS -->\n  <div>\n    <div class=\"section-title\" style=\"color:#c0392b; border-bottom-color:#c0392b;\">Potrącenia</div>\n    <table class=\"comp-table deductions\">\n      <thead>\n        <tr>\n          <th style=\"width:65%\">Składnik</th>\n          <th>Kwota</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for row in doc.deductions %}\n        <tr>\n          <td>{{ row.salary_component }}</td>\n          <td>{{ frappe.format(row.amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n        {% endfor %}\n        {% if not doc.deductions %}\n        <tr><td colspan=\"2\" style=\"text-align:center; color:#aaa; font-style:italic;\">Brak potrąceń</td></tr>\n        {% endif %}\n      </tbody>\n      <tfoot>\n        <tr>\n          <td>Łączne potrącenia</td>\n          <td>{{ frappe.format(doc.total_deduction, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n      </tfoot>\n    </table>\n  </div>\n</div>\n\n<!-- SUMMARY ROW -->\n<div class=\"summary-row\">\n  <div class=\"summary-box earnings-box\">\n    <div class=\"s-label\">Wynagrodzenie brutto</div>\n    <div class=\"s-value\">{{ frappe.format(doc.gross_pay, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n  </div>\n  <div class=\"summary-box deductions-box\">\n    <div class=\"s-label\">Łączne potrącenia</div>\n    <div class=\"s-value\">{{ frappe.format(doc.total_deduction, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n  </div>\n  <div class=\"summary-box\">\n    <div class=\"s-label\">Waluta</div>\n    <div class=\"s-value\">{{ doc.currency }}</div>\n  </div>\n</div>\n\n<!-- NET PAY BANNER -->\n<div class=\"net-pay-banner\">\n  <div class=\"label-col\">\n    <div class=\"main-label\">Wynagrodzenie netto do wypłaty</div>\n    {% if doc.total_in_words %}\n    <div class=\"words\">{{ doc.total_in_words }}</div>\n    {% endif %}\n  </div>\n  <div class=\"amount-col\">\n    <div class=\"net-amount\">{{ frappe.format(doc.rounded_total or doc.net_pay, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n    <div class=\"currency-label\">{{ doc.currency }}</div>\n  </div>\n</div>\n\n<!-- FOOTER -->\n<div class=\"slip-footer\">\n  <div class=\"footer-left\">\n    <div class=\"confidential-badge\">Poufne</div><br>\n    Dokument wygenerowany automatycznie &mdash; {{ frappe.format(frappe.utils.now(), {'fieldtype': 'Datetime'}) }}<br>\n    {{ company }}\n  </div>\n\n  <div style=\"display:flex; gap:30px;\">\n    <div class=\"signature-block\">\n      <div class=\"sig-line\">Podpis pracodawcy</div>\n    </div>\n    <div class=\"signature-block\">\n      <div class=\"sig-line\">Podpis pracownika / Data odbioru</div>\n    </div>\n  </div>\n</div>\n\n</body>\n</html>",
 "_user_tags": null,
 "_comments": null,
 "_assign": null,
 "_liked_by": null
}
