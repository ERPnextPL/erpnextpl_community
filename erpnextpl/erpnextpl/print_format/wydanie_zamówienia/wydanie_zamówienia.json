 "html": "<div style=\"font-family: Arial, sans-serif; font-size: 12px; padding: 40px 0px 20px 0px;\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 10px;\">\n    <div>\n      <h1 style=\"margin: 0; font-size: 29px;\">Wydanie Zam\u00f3wienia</h1>\n      <p style=\"margin: 0; font-size: 16px;\">{{ doc.name }}</p>\n    </div>\n    <div>\n        {% set cust_image = frappe.db.get_value(\"Customer\",doc.customer,\"image\") %}\n      <!-- Logo klienta -->\n      <img src=\"{{cust_image}}\" alt=\"Logo Klienta\" style=\"height: 80px;\">\n    </div>\n  </div>\n\n  <table style=\"width: 100%; margin-top: 30px;\">\n    <tr>\n      <td style=\"color: #888; font-size: 16px;\"><strong>Identyfikator podatkowy:</strong></td>\n      <td></td>\n      <td style=\"color: #888; font-size: 16px; padding-left: 280px;\"><strong>Data:</strong></td>\n    </tr>\n    <tr>\n      <td style=\"color: #000; font-size: 14px;\">{{ doc.tax_id or '' }}</td>\n      <td></td>\n      <td style=\"color: #000; font-size: 14px; padding-left: 280px;\">{{ doc.posting_date }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"3\" style=\"color: #888; font-size: 16px; padding-top: 20px;\"><strong>Nazwa klienta:</strong></td>\n    </tr>\n    <tr>\n      <td colspan=\"3\" style=\"color: #000; font-size: 14px;\">{{ doc.customer_name }}</td>\n    </tr>\n  </table>\n\n  <br>\n\n  <table style=\"width: 100%; border-collapse: collapse;\" border=\"1\">\n    <thead>\n      <tr>\n        <th style=\"padding: 5px;\">Nr</th>\n        <th style=\"padding: 5px;\">Kod identyfikacyjny</th>\n        <th style=\"padding: 5px;\">Numer Zam\u00f3wienia Klienta</th>\n        <th style=\"padding: 5px;\">Ilo\u015b\u0107</th>\n        <th style=\"padding: 5px;\">Ilo\u015b\u0107 paczek</th>\n      </tr>\n    </thead>\n    <tbody style=\"font-size: 13px;\">\n      {% for item in doc.items %}\n        {% set po_no = frappe.db.get_value(\"Sales Order\",item.against_sales_order,\"po_no\") %}\n      <tr>\n        <td style=\"padding: 5px;\">{{ loop.index }}</td>\n        <td style=\"padding: 5px;\">{{ item.item_code }}</td>\n        <td style=\"padding: 5px;\">{{ po_no }}</td>\n        <td style=\"padding: 5px;\">{{ item.qty }}</td>\n        <td style=\"padding: 5px;\">{{ item.custom_ilo\u015b\u0107_paczek }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <br><br>\n\n  <div>\n    <p style=\"color: #888; font-size: 16px; margin-bottom: 5px;\"><strong>Ca\u0142kowita ilo\u015b\u0107:</strong></p>\n    <p style=\"color: #000; font-size: 14px;\">{{ doc.total_qty }}</p>\n  </div>\n\n  <br><br><br>\n\n  <div style=\"margin-top: 80px;\">\n    <p style=\"color: #888; font-size: 16px; margin-bottom: 25px;\"><strong>Podpis:</strong></p>\n    <div style=\"width: 300px; height: 50px; border-bottom: 1px solid #000;\"></div>\n  </div>\n</div>\n",
